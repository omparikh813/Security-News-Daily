# Copy to .env for local runs (T3). .env is git-ignored. Never commit real keys.
OPENROUTER_API_KEY=
NVD_API_KEY=
# Optional: anthropic/claude-haiku-5.5 (FR-13). Any other value exits at startup.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
# Optional, local development behind a corporate proxy only.
# MALNEWS_ALLOW_PROXY=1
